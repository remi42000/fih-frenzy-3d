#!/usr/bin/env bash
# ==============================================================================
# fih frenzy 3D — Self-Extracting Linux Setup Installer (.run)
# ==============================================================================
set -euo pipefail

APP_VERSION="2611261955"
APP_NAME="fih frenzy 3D $APP_VERSION"

AUTO_YES=0
FORCE_CLI=0
WANT_MENU=1
WANT_BIN=1
WANT_DESKTOP=0
PLAY_AFTER=0
DO_UNINSTALL=0

for arg in "$@"; do
  case "$arg" in
    -y|--yes|--non-interactive) AUTO_YES=1 ;;
    --cli) FORCE_CLI=1 ;;
    --desktop-shortcut) WANT_DESKTOP=1 ;;
    --no-menu) WANT_MENU=0 ;;
    --play) PLAY_AFTER=1 ;;
    --uninstall) DO_UNINSTALL=1 ;;
    -h|--help)
      cat <<EOF
$APP_NAME ($APP_VERSION) — Linux Setup

Usage: $(basename "$0") [options]
  (no flags)           Interactive GUI/CLI Setup Wizard
  -y, --yes            Quick non-interactive install
  --desktop-shortcut   Place launcher icon on ~/Desktop
  --play               Launch $APP_NAME after installation
  --uninstall          Uninstall $APP_NAME
EOF
      exit 0
      ;;
  esac
done

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
INSTALL_DIR="$DATA_HOME/fih-frenzy-3d"
BIN_DIR="$HOME/.local/bin"
APPS_DIR="$DATA_HOME/applications"
ICON_PNG_DIR="$DATA_HOME/icons/hicolor/256x256/apps"

if [ "$DO_UNINSTALL" -eq 1 ]; then
  if [ -x "$INSTALL_DIR/fih-frenzy-3d-uninstall" ]; then
    exec "$INSTALL_DIR/fih-frenzy-3d-uninstall" $([ "$AUTO_YES" -eq 1 ] && echo "--yes" || true)
  fi
  rm -rf "$INSTALL_DIR"
  exit 0
fi

HAS_GUI=0
if [ "$AUTO_YES" -eq 0 ] && [ "$FORCE_CLI" -eq 0 ] && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v zenity >/dev/null 2>&1; then
  HAS_GUI=1
fi

if [ "$HAS_GUI" -eq 1 ]; then
  CHOICES="$(zenity --list --checklist \
    --title="$APP_NAME — Linux Setup" \
    --width=520 --height=350 \
    --text="Welcome to the <b>$APP_NAME</b> Installer!\n\n16-Bit High Color · 3D Phong Shaders · Feeding Frenzy 2 Campaign.\nChoose your setup options:" \
    --column="Enable" --column="Key" --column="Option" \
    --hide-column=2 --separator="|" \
    TRUE "MENU" "Add $APP_NAME to Applications Menu" \
    TRUE "BIN" "Add 'fih-frenzy-3d' command to ~/.local/bin" \
    TRUE "DESKTOP" "Create Desktop shortcut (~/Desktop)" \
  )" || exit 0
  WANT_MENU=0; WANT_BIN=0; WANT_DESKTOP=0
  [[ "|$CHOICES|" == *"|MENU|"* ]] && WANT_MENU=1
  [[ "|$CHOICES|" == *"|BIN|"* ]] && WANT_BIN=1
  [[ "|$CHOICES|" == *"|DESKTOP|"* ]] && WANT_DESKTOP=1
fi

echo "Installing $APP_NAME ($APP_VERSION) to $INSTALL_DIR ..."
rm -rf "$INSTALL_DIR/app"
mkdir -p "$INSTALL_DIR"

sed '1,/^__FIH_FRENZY_PAYLOAD_BASE64__$/d' "$0" | base64 -d | tar -xzf - -C "$INSTALL_DIR"
chmod +x "$INSTALL_DIR/fih-frenzy-3d" "$INSTALL_DIR/fih-frenzy-3d-uninstall"

mkdir -p "$ICON_PNG_DIR"
cp "$INSTALL_DIR/app/assets/fih-icon-256.png" "$ICON_PNG_DIR/fih-frenzy-3d.png"

if [ "$WANT_BIN" -eq 1 ]; then
  mkdir -p "$BIN_DIR"
  ln -sf "$INSTALL_DIR/fih-frenzy-3d" "$BIN_DIR/fih-frenzy-3d"
  ln -sf "$INSTALL_DIR/fih-frenzy-3d-uninstall" "$BIN_DIR/fih-frenzy-3d-uninstall"
fi

DESKTOP_CONTENT="[Desktop Entry]
Version=1.0
Type=Application
Name=$APP_NAME
GenericName=3D Phong Arcade Fish Game
Comment=16-bit High Color 3D Phong-shaded Feeding Frenzy 2 arcade game!
Exec=$INSTALL_DIR/fih-frenzy-3d
Icon=$ICON_PNG_DIR/fih-frenzy-3d.png
Terminal=false
Categories=Game;ArcadeGame;ActionGame;
StartupWMClass=FihFrenzy3D
StartupNotify=true
"

if [ "$WANT_MENU" -eq 1 ]; then
  mkdir -p "$APPS_DIR"
  printf "%s" "$DESKTOP_CONTENT" > "$APPS_DIR/fih-frenzy-3d.desktop"
  chmod +x "$APPS_DIR/fih-frenzy-3d.desktop"
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$APPS_DIR" 2>/dev/null || true
fi

if [ "$WANT_DESKTOP" -eq 1 ] && [ -d "$HOME/Desktop" ]; then
  rm -f "$HOME/Desktop"/fih-frenzy-3D*.desktop
  SHORTCUT_PATH="$HOME/Desktop/fih-frenzy-3D-$APP_VERSION.desktop"
  printf "%s" "$DESKTOP_CONTENT" > "$SHORTCUT_PATH"
  chmod +x "$SHORTCUT_PATH"
  command -v gio >/dev/null 2>&1 && gio set "$SHORTCUT_PATH" metadata::trusted true 2>/dev/null || true
fi

echo "Setup complete! Launch anytime via: fih-frenzy-3d"

if [ "$PLAY_AFTER" -eq 1 ]; then
  nohup "$INSTALL_DIR/fih-frenzy-3d" >/dev/null 2>&1 &
fi

exit 0
